[Unit]
Description=Theracure App
After=network.target

[Service]
Type=simple

User=fuckhacker
Group=fuckhacker

WorkingDirectory=/var/www/theracure/Theracure-Dashboard/.next/standalone
ExecStart=/usr/bin/node server.js

Environment=NODE_ENV=production
Environment=PORT=3001
Environment=PUPPETEER_EXECUTABLE_PATH=/home/fuckhacker/.cache/puppeteer/chrome/linux-146.0.7680.153/chrome-linux64/chrome

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target



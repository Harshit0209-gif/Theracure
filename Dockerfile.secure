# =========================
# Stage 1: Dependencies
# =========================
FROM node:20.18.1-bookworm-slim AS deps

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
COPY prisma ./prisma/

RUN pnpm install --frozen-lockfile


# =========================
# Stage 2: Builder
# =========================
FROM node:20.18.1-bookworm-slim AS builder

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Copy node_modules from deps
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

# Build and generate Prisma (same OS as production = correct binaries!)
RUN pnpm generate:enums && \
    pnpm build && \
    pnpm build:worker && \
    npx prisma generate


# =========================
# Stage 3: Production
# =========================
FROM node:20.18.1-bookworm-slim

# Install Chromium and dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        chromium \
        fonts-liberation \
        libnss3 \
        libatk-bridge2.0-0 \
        libxkbcommon0 \
        libgbm1 \
        libgtk-3-0 \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Environment variables
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3001 \
    NODE_OPTIONS="--max-old-space-size=768 --max-http-header-size=16384" \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    HOME=/home/nextjs \
    XDG_RUNTIME_DIR=/tmp/chromium-user-data

# Create user and directories
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs && \
    mkdir -p /home/nextjs/.cache /home/nextjs/.config/chromium \
             /home/nextjs/.local/share /tmp/chromium-user-data \
             /tmp/chrome-crash-dumps /app/uploads && \
    chown -R nextjs:nodejs /home/nextjs /tmp/chromium-user-data \
                           /tmp/chrome-crash-dumps /app/uploads && \
    chmod 700 /tmp/chromium-user-data /tmp/chrome-crash-dumps

# Copy Next.js standalone output (includes minimal node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Copy Prisma files AND generated client
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# Copy worker and config files
COPY --from=builder --chown=nextjs:nodejs /app/workers ./workers
COPY --from=builder --chown=nextjs:nodejs /app/lib ./lib
COPY --from=builder --chown=nextjs:nodejs /app/config ./config
COPY --from=builder --chown=nextjs:nodejs /app/docker-entrypoint.sh ./docker-entrypoint.sh

# Set permissions
RUN chmod +x /app/docker-entrypoint.sh && \
    chmod -R 555 /app && \
    chmod 755 /app/uploads

USER nextjs

EXPOSE 3001

CMD ["/app/docker-entrypoint.sh"]
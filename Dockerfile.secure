# =========================
# Stage 1: Dependencies
# =========================
FROM node:20.18.1-alpine AS deps
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
COPY prisma ./prisma/
RUN pnpm install --frozen-lockfile --prod=false


# =========================
# Stage 2: Builder
# =========================
FROM node:20.18.1-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm prisma:generate \
 && pnpm generate:enums \
 && pnpm build \
 && pnpm build:worker


# =========================
# Stage 3: Production Runner
# =========================
FROM node:20.18.1-bookworm-slim AS runner

# ---- Chromium runtime deps ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libnss3 \
    libatk-bridge2.0-0 \
    libxkbcommon0 \
    libgbm1 \
    libgtk-3-0 \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ---- Puppeteer config ----
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# ---- Runtime env ----
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV NODE_OPTIONS="--max-old-space-size=768 --max-http-header-size=16384"

# ---- Create non-root user ----
RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs --shell /bin/false --home /home/nextjs nextjs

# ---- Copy build output ----
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

COPY --from=builder --chown=nextjs:nodejs /app/workers/sms-worker.js ./workers/
COPY --from=builder --chown=nextjs:nodejs /app/lib/prisma.js ./lib/
COPY --from=builder --chown=nextjs:nodejs /app/lib/mail/sendSMS.js ./lib/mail/
COPY --from=builder --chown=nextjs:nodejs /app/config/smsTemplatesMap.js ./config/
COPY --from=builder --chown=nextjs:nodejs /app/lib/generated/smsEnums.js ./lib/generated/
COPY --from=builder --chown=nextjs:nodejs /app/docker-entrypoint.sh ./docker-entrypoint.sh

# ---- Chromium required directories (FIX) ----
RUN mkdir -p \
    /home/nextjs/.cache \
    /home/nextjs/.config/chromium \
    /home/nextjs/.local/share \
    /tmp/chromium-user-data \
    /tmp/chrome-crash-dumps \
 && chown -R nextjs:nodejs /home/nextjs /tmp/chromium-user-data /tmp/chrome-crash-dumps \
 && chmod 700 /tmp/chromium-user-data /tmp/chrome-crash-dumps \
 && chmod +x /app/docker-entrypoint.sh

# ---- Chromium environment ----
ENV HOME=/home/nextjs
ENV XDG_RUNTIME_DIR=/tmp/chromium-user-data

# ---- Lock application code ----
RUN chmod -R 555 /app && chmod 755 /app/uploads || true

USER nextjs

EXPOSE 3001

CMD ["/app/docker-entrypoint.sh"]

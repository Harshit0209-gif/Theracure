[Unit]
Description=Theracure SMS Worker
After=network.target

[Service]
Type=simple

User=fuckhacker
Group=fuckhacker

WorkingDirectory=/var/www/theracure/Theracure-Dashboard
ExecStart=/var/www/theracure/Theracure-Dashboard/node_modules/.bin/ts-node --esm -r tsconfig-paths/register --project tsconfig.json --transpile-only workers/sms-worker.ts

Environment=NODE_ENV=production

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target

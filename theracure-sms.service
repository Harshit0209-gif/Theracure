[Unit]
Description=Theracure SMS Worker
After=network.target

[Service]
Type=simple

User=fuckhacker
Group=fuckhacker

WorkingDirectory=/var/www/theracure/Theracure-Dashboard
ExecStart=/var/www/theracure/Theracure-Dashboard/node_modules/.bin/tsx workers/sms-worker.ts

EnvironmentFile=/var/www/theracure/Theracure-Dashboard/.env
Environment=NODE_ENV=production

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target

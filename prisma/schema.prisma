datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums
enum UserRole {
  ADMIN
  THERAPIST
  RECEPTIONIST
  CONTENT_MANAGER
}

enum UserStatus {
  ACTIVE         
  INACTIVE        
  SUSPENDED       
}

enum AssignmentStatus {
  CONFIRMED       
  COMPLETED       
  CANCELLED       
  NO_SHOW         
}

enum SessionStatus {
  SCHEDULED       
  IN_PROGRESS     
  COMPLETED       
  CANCELLED       
  NO_SHOW         
}

enum AppointmentStatus {
  CONFIRMED      
  RESCHEDULED     
  COMPLETED       
  CANCELLED       
}
enum InvoiceStatus {
  DUE
  PAID
  CANCELLED
}

enum ConsultationStatus {
  NOT_ASSIGN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Models
model User {
  id            String      @id @default(uuid()) @map("user_id")
  name          String
  email         String      @unique
  passwordHash  String      @map("password_hash")
  role          UserRole
  phone         String?
  status        UserStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  assignmentsCreated TherapistAssignment[] @relation("CreatedBy")
  therapistAssignments TherapistAssignment[] @relation("TherapistAssignments")
  therapistTimeSlots TherapistTimeSlot[] @relation("TherapistTimeSlots")
  therapist          Therapist?
 

  @@map("users")
}

model Patient {
  id              String   @id @db.VarChar(20) @map("patient_id")
  patientName     String    @map("patient_name")
  age             Int
  height          Float?    
  weight          Float?
  gender          String
  address         String?
  phone           String?
  email           String?
  referenceDoctor String?   @map("reference_doctor")
  createdBy       String    @map("created_by")
  medicalHistory  String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  status          UserStatus @default(ACTIVE) @map("status")  

  // Relations
  therapistAssignments TherapistAssignment[] @relation("PatientAssignments")
  prescriptions   Prescription[] @relation("PatientPrescriptions")
  therapySessions TherapySession[] @relation("PatientTherapySessions")
  invoices          Invoice[]
 

  @@map("patients")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  price       Float
  category    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //relation
  therapist_assignments TherapistAssignment[] @relation("ServiceTherapistAssignments")

  @@map("services")
}




model Therapist {
  id              String    @id @map("therapist_id")
  specialization  String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  qualification   String?
  experiences     String?
  status          UserStatus    @default(ACTIVE) @map("status")

  // Relations
  user            User      @relation(fields: [id], references: [id], onDelete: Cascade)
  timeSlots       TherapistTimeSlot[] @relation("TherapistTimeSlots")
  assignments     TherapistAssignment[] @relation("TherapistAssignments")
  prescriptions   Prescription[] @relation("TherapistPrescriptions")
  therapySessions TherapySession[] @relation("TherapistTherapySessions")

  @@map("therapists")
}

model TherapistTimeSlot {
  id            String    @id @default(uuid()) @map("slot_id")
  therapistId   String    @map("therapist_id")
  weekDay       Int       @map("week_day") // 0-6 (Sunday-Saturday)
  startTime     String    @map("start_time") // store time in "HH:mm" format
  endTime       String    @map("end_time")   // store time in "HH:mm" format
  isAvailable   Boolean   @default(true) @map("is_available")
  isRecurring   Boolean   @default(true) @map("is_recurring")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  therapist     User      @relation("TherapistTimeSlots", fields: [therapistId], references: [id], onDelete: Cascade, map: "therapist_time_slots_user_fkey")
  therapistInfo Therapist @relation("TherapistTimeSlots", fields: [therapistId], references: [id], map: "therapist_time_slots_therapist_fkey")

  @@map("therapist_time_slots")
  @@index([therapistId, weekDay])
}


model TherapistAssignment {
  id                    String            @id @default(uuid()) @map("assignment_id")
  patientId             String            @map("patient_id") @db.VarChar(20)
  therapistId           String            @map("therapist_id")
  appointmentStartTime  DateTime          @map("appointment_start_time")
  appointmentEndTime    DateTime          @map("appointment_end_time")
  serviceId             String?           @map("service_id")
  assignedDate          DateTime          @map("assigned_date") @db.Date
  status                AppointmentStatus @default(CONFIRMED)
  notes                 String?           @db.Text
  createdById           String            @map("created_by")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  // Relations
  patient               Patient           @relation("PatientAssignments", fields: [patientId], references: [id], onDelete: Cascade)
  therapist             User              @relation("TherapistAssignments", fields: [therapistId], references: [id], onDelete: Restrict, map: "therapist_assignments_user_fkey")
  therapistInfo         Therapist         @relation("TherapistAssignments", fields: [therapistId], references: [id], map: "therapist_assignments_therapist_fkey")
  createdBy             User              @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  service               Service?          @relation("ServiceTherapistAssignments", fields: [serviceId], references: [id])

  @@map("therapist_assignments")
  @@index([therapistId, appointmentStartTime])
  @@index([patientId, appointmentStartTime])
  @@index([appointmentStartTime])
  @@index([status])
}

model Prescription {
  id                String         @id @default(uuid()) @map("prescription_id")
  sessionId         String         @map("session_id")
  patientId         String         @map("patient_id") @db.VarChar(20)
  therapistId       String         @map("therapist_id")
  exercises         Json?          @map("exercises")
  medications       Json?          @map("medications")
  restrictions      String?        @map("restrictions") @db.Text
  followUpDate      DateTime?      @map("follow_up_date") @db.Date
  pdfUrl            String?        @map("pdf_url")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  session           TherapySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  patient           Patient        @relation("PatientPrescriptions", fields: [patientId], references: [id])
  therapist         Therapist      @relation("TherapistPrescriptions", fields: [therapistId], references: [id])
  

  @@map("prescriptions")
  @@index([sessionId])
  @@index([patientId])
  @@index([therapistId])
}

model Invoice {
  id              String    @id @map("invoice_id")
  patientId       String    @map("patient_id")
  date            DateTime  @default(now())
  subTotal        Float     @map("sub_total")  
  totalAmount     Float     @map("total_amount")
  amountPaid      Float    @default(0) @map("amount_paid")
  status          InvoiceStatus @default(DUE) 
  paymentMethod   String?   @map("payment_method")
  notes           String?
  offer           Float?

  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String   

  // Relations
  patient         Patient  @relation(fields: [patientId], references: [id])
  invoiceItems     InvoiceItem[] @relation("InvoiceToItems")


  @@index([patientId])
  @@index([id])
  @@index([status])
  @@index([date])
  @@map("invoices")
}

model InvoiceItem {
  id String @id @default(uuid())
  invoiceId     String
  serviceId     String  
  serviceName   String   
  priceAtPurchase Float  
  quantity      Int
  createdAt     DateTime @default(now())

  invoice       Invoice  @relation("InvoiceToItems",fields: [invoiceId], references: [id])

  @@map("invoice_items")
}


model TherapySession {
  id              String    @id @default(uuid()) @map("session_id")
  patientId       String    @map("patient_id") @db.VarChar(20)
  therapistId     String    @map("therapist_id")
  sessionNotes    String?   @map("session_notes") @db.Text
  sessionDate     DateTime  @map("session_date") @default(now())
  sessionData     Json?     @map("session_data")
  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  prescriptions   Prescription[]
  patient         Patient            @relation("PatientTherapySessions", fields: [patientId], references: [id])
  therapist       Therapist          @relation("TherapistTherapySessions", fields: [therapistId], references: [id])

  @@map("therapy_sessions")
  @@index([sessionDate])
  @@index([patientId])
  @@index([therapistId])
}


model Consultation {
  id              String   @id @default(cuid())
  name            String
  email           String?
  mobileNumber    String    @map("mobile_number")
  consultationDate DateTime  @map("consultation_date")
  consultationTime String    @map("consultation_time")
  note             String?   @db.Text
  status          ConsultationStatus @default(NOT_ASSIGN)
  consultationWith String  @map("consulation_with")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")
  createdBy       String   @map("created_by")
  


  @@index([id])
  @@index([consultationDate])
  @@index([status])
  @@map("consultations")
}
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid()) @map("user_id")
  name                   String
  email                  String              @unique
  passwordHash           String              @map("password_hash")
  role                   UserRole
  phone                  String?
  status                 UserStatus          @default(ACTIVE)
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  createdAppointments    Appointment[]       @relation("CreatedBy")
  therapistAppointments  Appointment[]       @relation("TherapistAppointments")
  uploadedMedicalRecords MedicalRecord[]     @relation("MedicalRecordUploader")
  therapistTimeSlots     TherapistTimeSlot[] @relation("TherapistTimeSlots")
  therapist              Therapist?

  @@map("users")
}

model Patient {
  id                    String           @id @default(dbgenerated("generate_patient_id()")) @map("patient_id") @db.VarChar(20)
  patientName           String           @map("patient_name")
  age                   Int
  height                Float?
  weight                Float?
  gender                String
  address               String?
  phone                 String?
  email                 String?
  referenceDoctor       String?          @map("reference_doctor")
  createdBy             String           @map("created_by")
  medicalHistory        String?
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at")
  status                UserStatus       @default(ACTIVE) @map("status")
  therapistAppointments Appointment[]    @relation("PatientAssignments")
  invoices              Invoice[]
  medicalRecords        MedicalRecord[]
  prescriptions         Prescription[]   @relation("PatientPrescriptions")
  therapySessions       TherapySession[] @relation("PatientTherapySessions")

  @@map("patients")
}

model Service {
  id                    String          @id @default(cuid())
  name                  String
  price                 Float
  description           String?
  isActive              Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  category              ServiceCategory
  therapistAppointments Appointment[]   @relation("ServiceTherapistAssignments")

  @@map("services")
}

model Therapist {
  id                    String              @id @map("therapist_id")
  specialization        String?
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  qualification         String?
  experiences           String?
  status                UserStatus          @default(ACTIVE) @map("status")
  therapistAppointments Appointment[]       @relation("TherapistAppointments")
  prescriptions         Prescription[]      @relation("TherapistPrescriptions")
  therapistTimeSlots    TherapistTimeSlot[] @relation("TherapistTimeSlots")
  user                  User                @relation(fields: [id], references: [id], onDelete: Cascade)
  therapySessions       TherapySession[]    @relation("TherapistTherapySessions")

  @@map("therapists")
}

model TherapistTimeSlot {
  id            String    @id @default(uuid()) @map("slot_id")
  therapistId   String    @map("therapist_id")
  weekDay       Int       @map("week_day")
  startTime     String    @map("start_time")
  endTime       String    @map("end_time")
  isAvailable   Boolean   @default(true) @map("is_available")
  isRecurring   Boolean   @default(true) @map("is_recurring")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  therapist     User      @relation("TherapistTimeSlots", fields: [therapistId], references: [id], onDelete: Cascade, map: "therapist_time_slots_user_fkey")
  therapistInfo Therapist @relation("TherapistTimeSlots", fields: [therapistId], references: [id], map: "therapist_time_slots_therapist_fkey")

  @@index([therapistId, weekDay])
  @@map("therapist_time_slots")
}

model Appointment {
  id                   String            @id @default(uuid()) @map("appointment_id")
  patientId            String?           @map("patient_id") @db.VarChar(20)
  therapistId          String            @map("therapist_id")
  appointmentStartTime DateTime          @map("appointment_start_time")
  appointmentEndTime   DateTime          @map("appointment_end_time")
  serviceId            String            @map("service_id")
  cubicleId            String?           @map("cubicle_id")
  assignedDate         DateTime          @map("assigned_date") @db.Date
  status               AppointmentStatus @default(CONFIRMED)
  notes                String?           @db.Text
  createdById          String            @map("created_by")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  isRecurring          Boolean           @default(false) @map("is_recurring")
  recurringType        RecurringType?    @map("recurring_type")
  recurringEndType     RecurringEndType? @map("recurring_end_type")
  recurringCount       Int?              @map("recurring_count")
  recurringEndDate     DateTime?         @map("recurring_end_date") @db.Date

  // Relations
  createdBy            User              @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  patient              Patient?          @relation("PatientAssignments", fields: [patientId], references: [id], onDelete: SetNull)
  service              Service?          @relation("ServiceTherapistAssignments", fields: [serviceId], references: [id])
  therapist            User              @relation("TherapistAppointments", fields: [therapistId], references: [id], onDelete: Restrict, map: "appointments_user_fkey")
  therapistInfo        Therapist         @relation("TherapistAppointments", fields: [therapistId], references: [id], map: "appointments_therapist_fkey")
  cubicle              Cubicle?          @relation("AppointmentCubicle", fields: [cubicleId], references: [id], onDelete: SetNull)

  @@index([therapistId, appointmentStartTime])
  @@index([patientId, appointmentStartTime])
  @@index([appointmentStartTime])
  @@index([status])
  @@index([cubicleId, appointmentStartTime])
  @@map("appointments")
}

model Prescription {
  id          String         @id @default(uuid()) @map("prescription_id")
  sessionId   String         @map("session_id")
  patientId   String?        @map("patient_id") @db.VarChar(20)
  therapistId String         @map("therapist_id")
  pdfUrl      String?        @map("pdf_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  patient     Patient?       @relation("PatientPrescriptions", fields: [patientId], references: [id])
  session     TherapySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  therapist   Therapist      @relation("TherapistPrescriptions", fields: [therapistId], references: [id])

  @@index([sessionId])
  @@index([patientId])
  @@index([therapistId])
  @@map("prescriptions")
}

model Invoice {
  id            String        @id @map("invoice_id")
  patientId     String?       @map("patient_id")
  date          DateTime      @default(now())
  subTotal      Float         @map("sub_total")
  totalAmount   Float         @map("total_amount")
  amountPaid    Float         @default(0) @map("amount_paid")
  status        InvoiceStatus @default(DUE)
  paymentMethod String?       @map("payment_method")
  notes         String?
  offer         Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String
  pdfUrl        String?       @map("pdf_url")
  invoiceItems  InvoiceItem[] @relation("InvoiceToItems")
  patient       Patient?      @relation(fields: [patientId], references: [id])
  transactions  Transaction[] @relation("InvoiceToTransactions")

  @@index([patientId])
  @@index([id])
  @@index([status])
  @@index([date])
  @@map("invoices")
}

model Transaction {
  id              String            @id @default(cuid()) @map("transaction_id")
  invoiceId       String            @map("invoice_id")
  amount          Float             @map("amount")
  paymentMethod   String?           @map("payment_method")
  transactionDate DateTime          @default(now()) @map("transaction_date")
  status          TransactionStatus @default(SUCCESS)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  invoice         Invoice           @relation("InvoiceToTransactions", fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([transactionDate])
  @@map("transactions")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  serviceId       String
  serviceName     String
  priceAtPurchase Float
  quantity        Int
  createdAt       DateTime @default(now())
  category        String?
  description     String?
  invoice         Invoice  @relation("InvoiceToItems", fields: [invoiceId], references: [id])

  @@map("invoice_items")
}

model TherapySession {
  id            String         @id @default(uuid()) @map("session_id")
  patientId     String?        @map("patient_id") @db.VarChar(20)
  therapistId   String         @map("therapist_id")
  sessionNotes  String?        @map("session_notes")
  sessionDate   DateTime       @default(now()) @map("session_date")
  sessionData   Json?          @map("session_data")
  completed     Boolean        @default(false)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  prescriptions Prescription[]
  patient       Patient?       @relation("PatientTherapySessions", fields: [patientId], references: [id])
  therapist     Therapist      @relation("TherapistTherapySessions", fields: [therapistId], references: [id])

  @@index([sessionDate])
  @@index([patientId])
  @@index([therapistId])
  @@map("therapy_sessions")
}

model Consultation {
  id               String             @id @default(cuid())
  name             String
  email            String?
  mobileNumber     String             @map("mobile_number")
  consultationDate DateTime           @map("consultation_date")
  consultationTime String             @map("consultation_time")
  note             String?
  status           ConsultationStatus @default(NOT_ASSIGN)
  consultationWith String             @map("consulation_with")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @map("updated_at")
  createdBy        String             @map("created_by")

  @@index([id])
  @@index([consultationDate])
  @@index([status])
  @@map("consultations")
}

model MedicalRecord {
  id               String       @id @default(uuid()) @db.Uuid
  patientId        String?      @map("patient_id")
  documentType     DocumentType @map("document_type")
  fileName         String       @map("file_name")
  fileUrl          String?      @map("file_url")
  fileSize         Int          @map("file_size")
  uploadedBy       String       @map("uploaded_by")
  uploadDate       DateTime     @default(now()) @map("upload_date")
  tags             String[]     @default([])
  category         String?
  description      String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  filePath         String       @map("file_path")
  originalFileName String       @map("original_file_name")
  patient          Patient?     @relation(fields: [patientId], references: [id])
  uploadedByUser   User         @relation("MedicalRecordUploader", fields: [uploadedBy], references: [id])

  @@index([patientId])
  @@index([documentType])
  @@index([uploadDate])
  @@index([uploadedBy])
  @@map("medical_records")
}

model SmsQueue {
  id        String    @id @default(cuid())
  type      String
  phone     String
  variables Json?
  status    SmsStatus @default(PENDING)
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([id])
  @@index([phone])
  @@map("sms_queue")
}

enum UserRole {
  ADMIN
  THERAPIST
  RECEPTIONIST
  CONTENT_MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AssignmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentStatus {
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DUE
  PAID
  CANCELLED
}

enum ConsultationStatus {
  NOT_ASSIGN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum RecurringType {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum RecurringEndType {
  COUNT
  DATE
}

enum ServiceCategory {
  MANUAL_THERAPY
  CONSULTATION
  ELECTROTHERAPY
  EXERCISE_THERAPY
  COMBO_TREATMENT
}

enum DocumentType {
  PRESCRIPTION
  DIAGNOSTIC
  NOTES
  THERAPY_SUMMARY
  LAB_REPORT
  XRAY
  MRI
  CT_SCAN
  ULTRASOUND
  OTHER

  @@map("document_type")
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
  REFUNDED
}

enum SmsStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Cubicle {
  id          String        @id @default(cuid()) @map("cubicle_id")
  name        String
  description String?       @db.Text
  roomNumber  String?       @map("room_number")
  location    String?
  status      CubicleStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  createdBy   String        @map("created_by")

  // Relations
  appointments Appointment[] @relation("AppointmentCubicle")

  @@index([status])
  @@index([createdAt])
  @@map("cubicles")
}

enum CubicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

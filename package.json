{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "tsc --project tsconfig.worker.json && tsc-alias -p tsconfig.worker.json",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "generate:enums": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' lib/scripts/generate-enums.ts",
    "prebuild": "pnpm prisma:generate && pnpm generate:enums",
    "migrate:deploy": "prisma migrate deploy",
    "worker:sms": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}' workers/sms-worker.ts"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json -r tsconfig-paths/register prisma/seed.ts"
  },
